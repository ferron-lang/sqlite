// Hand-written: what `anvil ffi gen` skips but the safe layer needs.
// `sqlite3_bind_text` takes a destructor function pointer, a callback that
// FFI stage 1 cannot express; the parameter is declared as an address-sized
// integer, and the package only passes `SQLITE_TRANSIENT`, so SQLite copies
// the text before the call returns (the `CStr` copy is freed after it).

use std.ffi.{CStr, Ptr}
use pkg.sys.sqlite3.sqlite3_stmt

/// `SQLITE_TRANSIENT`, `(sqlite3_destructor_type)-1`: SQLite copies the
/// value.
pub const SQLITE_TRANSIENT: usize = 18446744073709551615usize

extern "C" {
  pub fn sqlite3_bind_text(stmt: Ptr[sqlite3_stmt], index: i32, text: CStr, bytes: i32, destructor: usize) -> i32
}
