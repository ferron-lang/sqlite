// `sqlite.database`: `Database` and `Transaction` over a `sqlite3*`
// connection, statements prepared as `sqlite3_stmt*` resources, parameters
// bound through `sqlite3_bind_*`, and rows decoded through `FromData`.

use std.bytes.Bytes
use std.collections.Map
use std.data.{FromData, Value, to_value}
use std.encoding.base64.encode
use std.ffi.{Out, Ptr}
use std.fs.{Fs, Path}
use std.test.TestContext
use pkg.error.{Decode, Parameter, SqliteError, SqliteErrorKind, failure, last_error}
use pkg.sys.hand.{SQLITE_TRANSIENT, sqlite3_bind_text}
use pkg.sys.sqlite3.{
  sqlite3,
  sqlite3_bind_double,
  sqlite3_bind_int64,
  sqlite3_bind_null,
  sqlite3_bind_parameter_count,
  sqlite3_bind_parameter_name,
  sqlite3_close_v2,
  sqlite3_column_blob,
  sqlite3_column_bytes,
  sqlite3_column_count,
  sqlite3_column_double,
  sqlite3_column_int64,
  sqlite3_column_name,
  sqlite3_column_text,
  sqlite3_column_type,
  sqlite3_complete,
  sqlite3_finalize,
  sqlite3_last_insert_rowid,
  sqlite3_next_stmt,
  sqlite3_open,
  sqlite3_prepare_v2,
  sqlite3_step,
  sqlite3_stmt,
  sqlite3_total_changes64
}

const SQLITE_OK: i32 = 0
const SQLITE_ROW: i32 = 100
const SQLITE_DONE: i32 = 101
const SQLITE_INTEGER: i32 = 1
const SQLITE_FLOAT: i32 = 2
const SQLITE_TEXT: i32 = 3
const SQLITE_BLOB: i32 = 4

/// A SQLite database connection, a resource closed with
/// `sqlite3_close_v2`: a file opened with `Database.open(env.fs, path)`, or
/// an in-memory one from `Database.memory()`.
///
/// Each `execute` or `query` outside a transaction commits on its own.
/// `BEGIN` ... `COMMIT` statements, or a `Transaction` from
/// `transaction()`, group statements into one atomic commit.
///
/// Pass values as parameters, never by building SQL text from them: the
/// `params` argument binds `?`, `?N`, `:name`, `@name`, and `$name`. A
/// list or tuple binds by position (`?N` takes the N-th value), a struct or
/// `Map[String, _]` by name, a single scalar binds the one parameter, and
/// `Value.Null` binds none. `Int`, `f64`, `String`, `Bool` (as 0 or 1),
/// and `None` (as `NULL`) bind; a `Bytes` becomes base64 text, because
/// `std.data` has no bytes value.
#[foreign_resource(close = sqlite3_close_v2)]
pub struct Database {
  ptr: Ptr[sqlite3]
}

/// A transaction on a `Database`, a resource from `db.transaction()`:
/// `commit` makes its statements durable at once, and closing it without a
/// commit (or a failed commit) rolls them back. It runs on the database's
/// connection, so statements on the database while it is open belong to
/// it; run them through the transaction.
pub struct Transaction {
  // Fields close in declaration order: `ROLLBACK` runs (a no-op after a
  // commit), then its statement is finalized.
  rollback: Rollback,
  statement: Statement,
  db: Ptr[sqlite3],
}

// A prepared statement; null for SQL without one (blank or a comment).
#[foreign_resource(close = sqlite3_finalize)]
struct Statement {
  ptr: Ptr[sqlite3_stmt]
}

// A prepared `ROLLBACK` that closing steps.
#[foreign_resource(close = sqlite3_step)]
struct Rollback {
  ptr: Ptr[sqlite3_stmt]
}

// The rows of a script's last statement and the rows all of it changed.
struct Outcome {
  changes: Int,
  rows: List[Value],
}

impl Database {
  /// The database in the file at `path`, created empty when it does not
  /// exist. `fs` is the capability to touch files; SQLite opens the file
  /// itself.
  pub fn open(fs: Fs, path: Path) -> Result[Database, SqliteError] {
    let _ = fs
    return connect("{path}")
  }

  /// A new empty database in memory, gone when it closes.
  pub fn memory() -> Database {
    return connect(":memory:").expect_ok("SQLite opens an in-memory database")
  }

  /// Runs every statement in `sql` with `params` (see `Database`) and
  /// returns how many rows they inserted, changed, or deleted (counting
  /// those of triggers).
  pub fn execute[P](self, sql: String, params: P) -> Result[Int, SqliteError] {
    return changes(run(self.ptr, sql, to_value(params))?)
  }

  /// The rows the last statement in `sql` returns, each decoded from a
  /// `Value.Map` of column names to values as a `T: FromData`, like
  /// `std.json`'s `P.from_json`. `NULL` decodes as `Value.Null`, integers
  /// as `Int`, reals as `Float`, text as `String`, and a blob as base64
  /// text (which a `Bytes` field decodes). A row that does not fit `T` is
  /// a `Decode` error.
  pub fn query[T, P](self, sql: String, params: P) -> Result[List[T], SqliteError] where T: FromData {
    return decode(run(self.ptr, sql, to_value(params))?)
  }

  /// Opens a transaction (`BEGIN`); see `Transaction`. A transaction still
  /// open on this database is a `Sql` error.
  pub fn transaction(self) -> Result[Transaction, SqliteError] {
    let statement = prepare(self.ptr, "ROLLBACK")?
    let _ = run(self.ptr, "BEGIN", Value.Null)?
    let ptr = statement.ptr
    return Ok(Transaction { rollback: Rollback { ptr: ptr }, statement: move statement, db: self.ptr })
  }

  /// The rowid of the last row an `INSERT` on this connection added.
  pub fn last_insert_rowid(self) -> Int {
    return sqlite3_last_insert_rowid(self.ptr)
  }

  /// Closes the database now instead of at the end of its owner's scope;
  /// a transaction still open is rolled back.
  pub fn close(take self) -> Result[Unit, SqliteError] {
    return Ok(Unit)
  }

  pub(pkg) fn raw(self) -> Ptr[sqlite3] {
    return self.ptr
  }
}

impl Transaction {
  /// Runs every statement in `sql` inside the transaction; see
  /// `Database.execute`.
  pub fn execute[P](self, sql: String, params: P) -> Result[Int, SqliteError] {
    return changes(run(self.db, sql, to_value(params))?)
  }

  /// The rows of the last statement in `sql`, as `Database.query` decodes
  /// them; the transaction sees its own changes.
  pub fn query[T, P](self, sql: String, params: P) -> Result[List[T], SqliteError] where T: FromData {
    return decode(run(self.db, sql, to_value(params))?)
  }

  /// The rowid of the last row an `INSERT` on the connection added.
  pub fn last_insert_rowid(self) -> Int {
    return sqlite3_last_insert_rowid(self.db)
  }

  /// Makes every change of the transaction durable at once (`COMMIT`). A
  /// failed commit, such as `Busy`, rolls the transaction back.
  pub fn commit(take self) -> Result[Unit, SqliteError] {
    let _ = run(self.db, "COMMIT", Value.Null)?
    return Ok(Unit)
  }

  /// Drops every change of the transaction (`ROLLBACK`), as closing it
  /// does.
  pub fn rollback(take self) -> Unit {
  }
}

fn connect(name: String) -> Result[Database, SqliteError] {
  let out = Out[Ptr[sqlite3]].new()
  let code = sqlite3_open(name, out)
  // A failed open still returns a handle to close (null when out of memory,
  // which `sqlite3_close_v2` ignores).
  let db = Database { ptr: out.get() }
  if code != SQLITE_OK {
    return Err(last_error(db.ptr))
  }
  return Ok(move db)
}

fn changes(outcome: Outcome) -> Result[Int, SqliteError] {
  return Ok(outcome.changes)
}

fn decode[T](outcome: Outcome) -> Result[List[T], SqliteError] where T: FromData {
  var out: List[T] = []
  for row in outcome.rows {
    match T.from_value(row) {
      Ok(decoded) => out.push(decoded)
      Err(error) => return Err(failure(Decode(error.kind), "{error}"))
    }
  }
  return Ok(out)
}

// Runs the statements of `sql` one by one, each with `params`. A statement
// ends at the first `;` where `sqlite3_complete` says it is complete (not
// inside a string, comment, or trigger body); text after the last `;` is
// one more statement.
fn run(db: Ptr[sqlite3], sql: String, params: Value) -> Result[Outcome, SqliteError] {
  let before = sqlite3_total_changes64(db)
  var rows: List[Value] = []
  var pending = ""
  let parts = sql.split(";")
  for (index, part) in parts.enumerate() {
    pending = pending + part
    if index + 1 < parts.len() {
      pending = pending + ";"
      if sqlite3_complete(pending) == 0 {
        continue
      }
    }
    match run_one(db, pending, params)? {
      Some(result) => rows = result
      None => {
      }
    }
    pending = ""
  }
  return Ok(Outcome { changes: sqlite3_total_changes64(db) - before, rows: rows })
}

// One statement's rows; `None` for SQL without a statement.
fn run_one(db: Ptr[sqlite3], sql: String, params: Value) -> Result[Option[List[Value]], SqliteError] {
  let statement = prepare(db, sql)?
  let stmt = statement.ptr
  if stmt.is_null() {
    return Ok(None)
  }
  bind(db, stmt, params)?
  var names: List[String] = []
  for column in 0..Int.from(sqlite3_column_count(stmt)) {
    names.push(String.from_c(sqlite3_column_name(stmt, c_int(column))).unwrap_or("<not UTF-8>"))
  }
  var rows: List[Value] = []
  while true {
    let code = sqlite3_step(stmt)
    if code == SQLITE_DONE {
      break
    }
    if code != SQLITE_ROW {
      return Err(last_error(db))
    }
    var entries: Map[String, Value] = Map.new()
    for (column, name) in names.enumerate() {
      entries.insert(name, column_value(stmt, c_int(column)))
    }
    rows.push(Value.Map(entries))
  }
  return Ok(Some(rows))
}

fn prepare(db: Ptr[sqlite3], sql: String) -> Result[Statement, SqliteError] {
  let out = Out[Ptr[sqlite3_stmt]].new()
  let tail = Out[Ptr[u8]].new()
  let code = sqlite3_prepare_v2(db, sql, -1, out, tail)
  let statement = Statement { ptr: out.get() }
  if code != SQLITE_OK {
    return Err(last_error(db))
  }
  return Ok(move statement)
}

fn column_value(stmt: Ptr[sqlite3_stmt], column: i32) -> Value {
  let kind = sqlite3_column_type(stmt, column)
  if kind == SQLITE_INTEGER {
    return Value.Int(sqlite3_column_int64(stmt, column))
  }
  if kind == SQLITE_FLOAT {
    return Value.Float(sqlite3_column_double(stmt, column))
  }
  if kind == SQLITE_TEXT {
    // `sqlite3_column_text` first, then the size of that UTF-8 text.
    let text = sqlite3_column_text(stmt, column)
    return Value.String(String.from_utf8_lossy(Bytes.from_c_len(text, size(sqlite3_column_bytes(stmt, column)))))
  }
  if kind == SQLITE_BLOB {
    let blob = sqlite3_column_blob(stmt, column)
    return Value.String(encode(Bytes.from_c_len(blob, size(sqlite3_column_bytes(stmt, column)))))
  }
  return Value.Null
}

fn bind(db: Ptr[sqlite3], stmt: Ptr[sqlite3_stmt], params: Value) -> Result[Unit, SqliteError] {
  let count = Int.from(sqlite3_bind_parameter_count(stmt))
  match params {
    Value.List(items) => {
      if items.len() != count {
        return Err(
          failure(Parameter, "the statement has {count} parameters but {items.len()} values were supplied")
        )
      }
      for (index, item) in items.enumerate() {
        bind_one(db, stmt, index + 1, item)?
      }
    }
    Value.Map(entries) => {
      for index in 1..count + 1 {
        let name = sqlite3_bind_parameter_name(stmt, c_int(index))
        // `?` has no name and `?N` is named `?N`.
        let text = if name.is_null() {
          "?"
        } else {
          String.from_c(name).unwrap_or("?")
        }
        if text.starts_with("?") {
          return Err(failure(Parameter, "parameter {index} has no name, so a struct or map cannot bind it"))
        }
        match entries.get(text.slice(1, text.len())) {
          Some(item) => bind_one(db, stmt, index, item)?
          None => return Err(failure(Parameter, "no value for parameter {text}"))
        }
      }
    }
    Value.Null => {
      if count > 0 {
        return Err(failure(Parameter, "the statement has {count} parameters but none were supplied"))
      }
    }
    _ => {
      if count != 1 {
        return Err(failure(Parameter, "the statement has {count} parameters but 1 value was supplied"))
      }
      bind_one(db, stmt, 1, params)?
    }
  }
  return Ok(Unit)
}

fn bind_one(db: Ptr[sqlite3], stmt: Ptr[sqlite3_stmt], index: Int, value: Value) -> Result[Unit, SqliteError] {
  let at = c_int(index)
  let code = match value {
    Value.Null => sqlite3_bind_null(stmt, at)
    Value.Bool(v) => sqlite3_bind_int64(stmt, at, if v {
      1
    } else {
      0
    })
    Value.Int(v) => sqlite3_bind_int64(stmt, at, v)
    Value.Float(v) => sqlite3_bind_double(stmt, at, v)
    // Text over 2 GiB passes -1 (up to the NUL), which SQLite rejects as
    // `TooLarge`.
    Value.String(v) => sqlite3_bind_text(stmt, at, v, v.byte_len().try_to_i32().unwrap_or(-1), SQLITE_TRANSIENT)
    Value.BigInt(digits) => return Err(failure(Parameter, "{digits} does not fit a 64-bit integer"))
    _ => return Err(failure(Parameter, "a list or map cannot bind a parameter"))
  }
  if code != SQLITE_OK {
    return Err(last_error(db))
  }
  return Ok(Unit)
}

fn c_int(value: Int) -> i32 {
  return value.try_to_i32().expect_ok("a column or parameter index fits i32")
}

fn size(bytes: i32) -> usize {
  return bytes.try_to_usize().expect_ok("SQLite sizes are not negative")
}

// --- Tests ------------------------------------------------------------------

// Test types carry a `Test` prefix: a consumer's type of the same name
// would otherwise share their generic instantiations (a compiler bug).

#[derive(Data)]
struct TestNewUser {
  name: String,
  age: Option[Int],
  admin: Bool,
}

#[derive(Data)]
struct TestUser {
  id: Int,
  name: String,
  age: Option[Int],
  admin: Int,
}

#[derive(Data)]
struct TestStrict {
  id: String,
}

#[derive(Data)]
struct TestLimit {
  n: Int,
}

/// `ok <changes>` or `error <error>`.
fn exec[P](db: Database, sql: String, params: P) -> String {
  match db.execute(sql, params) {
    Ok(changes) => return "ok {changes}"
    Err(error) => return "error {error}"
  }
}

/// The `name` column of table `t` in order.
fn names(db: Database) -> List[String] {
  let rows: Result[List[Value], SqliteError] = db.query("SELECT name FROM t ORDER BY name", Value.Null)
  return rows.expect_ok("names").map(|row| row.get("name").expect_some("a name").as_string().expect_some("text"))
}

/// Whether every statement prepared on `db` is finalized.
fn finalized(db: Database) -> Bool {
  return sqlite3_next_stmt(db.raw(), Ptr.null()).is_null()
}

#[test("an in-memory database creates, inserts with parameters, and queries into a struct")]
fn memory_round_trip() -> Unit {
  let db = Database.memory()
  expect.equal(
    exec(db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INT, admin INT)", Value.Null),
    "ok 0"
  )
  expect.equal(exec(db, "INSERT INTO users (name, age, admin) VALUES (?, ?, ?)", ("ann", 31, true)), "ok 1")
  expect.equal(db.last_insert_rowid(), 1)
  let users: Result[List[TestUser], SqliteError] = db.query("SELECT * FROM users WHERE name = ?", "ann")
  expect.equal(
    users.expect_ok("query").map(|user| "{user.id} {user.name} {user.age} {user.admin}"),
    ["1 ann Some(31) 1"]
  )
}

#[test("parameters bind by position, number, and name; binding errors are Parameter errors")]
fn parameters() -> Unit {
  let db = Database.memory()
  expect.equal(
    exec(db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INT, admin INT)", Value.Null),
    "ok 0"
  )
  // Positional `?` from a tuple or a list, and `?N` by number.
  expect.equal(exec(db, "INSERT INTO users (name, age, admin) VALUES (?, ?, ?)", ("ann", 31, true)), "ok 1")
  expect.equal(exec(db, "INSERT INTO users (name, age, admin) VALUES (?, ?, ?)", ["bob", "41", "0"]), "ok 1")
  expect.equal(exec(db, "INSERT INTO users (admin, age, name) VALUES (?3, ?2, ?1)", ("cy", 22, false)), "ok 1")
  // Named parameters from a struct or a map; `None` binds NULL.
  expect.equal(
    exec(
      db,
      "INSERT INTO users (name, age, admin) VALUES (:name, :age, :admin)",
      TestNewUser { name: "dee", age: None, admin: false }
    ),
    "ok 1"
  )
  var named: Map[String, Value] = Map.new()
  named.insert("who", Value.String("eve"))
  named.insert("years", Value.Int(52))
  expect.equal(exec(db, "INSERT INTO users (name, age, admin) VALUES (@who, $years, 0)", named), "ok 1")
  // A single scalar binds the one parameter; text stays text, so a quote
  // in it is just a quote.
  expect.equal(
    exec(db, "INSERT INTO users (name, admin) VALUES (?, 0)", "o'brien'); DROP TABLE users; --"),
    "ok 1"
  )
  let users: Result[List[TestUser], SqliteError] = db.query("SELECT * FROM users WHERE id > ? ORDER BY id", 0)
  expect.equal(
    users.expect_ok("users").map(|user| "{user.id} {user.name} {user.age} {user.admin}"),
    [
      "1 ann Some(31) 1",
      "2 bob Some(41) 0",
      "3 cy Some(22) 0",
      "4 dee None 0",
      "5 eve Some(52) 0",
      "6 o'brien'); DROP TABLE users; -- None 0",
    ],
  )
  // A repeated name is one parameter.
  let same: Result[List[TestUser], SqliteError] = db.query("SELECT * FROM users WHERE age > :n OR id = :n", TestLimit { n: 40 })
  expect.equal(same.expect_ok("same").len(), 2)
  // Binding errors.
  expect.equal(
    exec(db, "INSERT INTO users (name) VALUES (?)", ("a", "b")),
    "error Parameter: the statement has 1 parameters but 2 values were supplied"
  )
  expect.equal(
    exec(db, "INSERT INTO users (name, age) VALUES (?, ?)", "a"),
    "error Parameter: the statement has 2 parameters but 1 value was supplied"
  )
  expect.equal(
    exec(db, "INSERT INTO users (name) VALUES (:name)", Value.Null),
    "error Parameter: the statement has 1 parameters but none were supplied"
  )
  expect.equal(
    exec(db, "INSERT INTO users (name) VALUES (?)", Value.Map(Map.new())),
    "error Parameter: parameter 1 has no name, so a struct or map cannot bind it"
  )
  expect.equal(
    exec(db, "INSERT INTO users (name) VALUES (?1)", Value.Map(Map.new())),
    "error Parameter: parameter 1 has no name, so a struct or map cannot bind it"
  )
  expect.equal(
    exec(
      db,
      "INSERT INTO users (name) VALUES (:missing)",
      TestNewUser { name: "x", age: None, admin: false }
    ),
    "error Parameter: no value for parameter :missing"
  )
  expect.equal(
    exec(db, "INSERT INTO users (name) VALUES (?)", [[1]]),
    "error Parameter: a list or map cannot bind a parameter"
  )
  // The limit is a compile option of the library (32766 by default).
  expect.equal(
    exec(db, "SELECT ?0", 1).starts_with("error Sql: variable number must be between ?1 and ?"),
    true
  )
  expect.equal(finalized(db), true)
}

#[test("a row that does not fit the requested type is a Decode error")]
fn decode_error() -> Unit {
  let db = Database.memory()
  expect.equal(
    exec(db, "CREATE TABLE users (id INTEGER PRIMARY KEY); INSERT INTO users VALUES (1)", Value.Null),
    "ok 1"
  )
  let strict: Result[List[TestStrict], SqliteError] = db.query("SELECT id FROM users", Value.Null)
  match strict {
    Ok(_) => expect.equal("decoded", "a Decode error")
    Err(error) => {
      expect.equal("{error.kind}", "Decode(WrongType)")
      expect.equal(error.code, 0)
    }
  }
}

#[test("every storage class decodes: NULL, integers, reals, text, and blobs as base64")]
fn storage_classes() -> Unit {
  let db = Database.memory()
  expect.equal(
    exec(
      db,
      "CREATE TABLE kinds (v);
       INSERT INTO kinds VALUES (NULL), (0), (1), (127), (-128), (32767), (-70000), (8388608),
         (2147483648), (1099511627776), (4611686018427387904), (-9223372036854775808),
         (3.25), (-0.5), ('text'), (''), (x'0102'), (x''), ('ünïcödé')",
      Value.Null,
    ),
    "ok 19",
  )
  let rows: Result[List[Value], SqliteError] = db.query("SELECT v FROM kinds ORDER BY rowid", Value.Null)
  expect.equal(
    rows.expect_ok("kinds").map(|row| "{row.get("v").expect_some("v")}"),
    [
      "Null",
      "Int(0)",
      "Int(1)",
      "Int(127)",
      "Int(-128)",
      "Int(32767)",
      "Int(-70000)",
      "Int(8388608)",
      "Int(2147483648)",
      "Int(1099511627776)",
      "Int(4611686018427387904)",
      "Int(-9223372036854775808)",
      "Float(3.25)",
      "Float(-0.5)",
      "String(text)",
      "String()",
      "String(AQI=)",
      "String()",
      "String(ünïcödé)",
    ],
  )
  // Text with a NUL inside binds whole.
  expect.equal(exec(db, "INSERT INTO kinds VALUES (?)", "a\0b"), "ok 1")
  let lengths: Result[List[Value], SqliteError] = db.query("SELECT length(CAST(v AS BLOB)) AS n FROM kinds WHERE rowid = 20", Value.Null)
  expect.equal("{lengths.expect_ok("length")}", "[Map({{n: Int(3)}})]")
}

#[test("BEGIN, COMMIT, and ROLLBACK statements group changes; misuse is SQLite's error")]
fn transaction_statements() -> Unit {
  let db = Database.memory()
  expect.equal(exec(db, "CREATE TABLE t (name TEXT)", Value.Null), "ok 0")
  expect.equal(
    exec(db, "BEGIN; INSERT INTO t VALUES ('a'); INSERT INTO t VALUES ('b'); COMMIT", Value.Null),
    "ok 2"
  )
  expect.equal(names(db), ["a", "b"])
  // BEGIN ... ROLLBACK, also of a schema change.
  expect.equal(
    exec(
      db,
      "BEGIN TRANSACTION; DELETE FROM t; CREATE TABLE extra (x); INSERT INTO t VALUES ('c')",
      Value.Null
    ),
    "ok 3"
  )
  expect.equal(names(db), ["c"])
  expect.equal(exec(db, "ROLLBACK", Value.Null), "ok 0")
  expect.equal(names(db), ["a", "b"])
  expect.equal(exec(db, "SELECT * FROM extra", Value.Null), "error Sql: no such table: extra")
  // A failing statement inside a transaction leaves it open.
  expect.equal(exec(db, "BEGIN; INSERT INTO t VALUES ('d')", Value.Null), "ok 1")
  expect.equal(exec(db, "INSERT INTO nowhere VALUES (1)", Value.Null), "error Sql: no such table: nowhere")
  expect.equal(exec(db, "END", Value.Null), "ok 0")
  expect.equal(names(db), ["a", "b", "d"])
  expect.equal(exec(db, "COMMIT", Value.Null), "error Sql: cannot commit - no transaction is active")
  expect.equal(exec(db, "ROLLBACK", Value.Null), "error Sql: cannot rollback - no transaction is active")
  expect.equal(
    exec(db, "BEGIN; BEGIN", Value.Null),
    "error Sql: cannot start a transaction within a transaction"
  )
  match db.transaction() {
    Ok(tx) => {
      tx.rollback()
      expect.equal("began", "an error")
    }
    Err(error) => expect.equal("{error}", "Sql: cannot start a transaction within a transaction")
  }
  expect.equal(exec(db, "ROLLBACK", Value.Null), "ok 0")
  expect.equal(finalized(db), true)
}

#[
  test("a Transaction commits on commit and rolls back on rollback, on drop, and after a failed commit"),
]
fn transaction_resource() -> Unit {
  let db = Database.memory()
  expect.equal(exec(db, "CREATE TABLE t (name TEXT); INSERT INTO t VALUES ('a')", Value.Null), "ok 1")
  // Commits on `commit`...
  with tx = db.transaction().expect_ok("begin") {
    expect.equal(tx.execute("INSERT INTO t VALUES (?)", "e"), Ok(1))
    expect.equal(tx.last_insert_rowid(), 2)
    let inside: Result[List[Value], SqliteError] = tx.query("SELECT name FROM t WHERE name = 'e'", Value.Null)
    expect.equal(inside.expect_ok("inside").len(), 1)
    match tx.execute("BEGIN", Value.Null) {
      Ok(_) => expect.equal("began", "an error")
      Err(error) => expect.equal("{error}", "Sql: cannot start a transaction within a transaction")
    }
    expect.equal(finalized(db), false)
    expect.equal(tx.commit().is_ok(), true)
  }
  expect.equal(names(db), ["a", "e"])
  // ... rolls back on `rollback` ...
  with tx = db.transaction().expect_ok("begin") {
    expect.equal(tx.execute("DELETE FROM t", Value.Null), Ok(2))
    tx.rollback()
  }
  expect.equal(names(db), ["a", "e"])
  // ... when it closes without either ...
  with tx = db.transaction().expect_ok("begin") {
    expect.equal(tx.execute("INSERT INTO t VALUES ('lost')", Value.Null), Ok(1))
  }
  expect.equal(names(db), ["a", "e"])
  // ... and after a commit that failed: a deferred foreign key is checked
  // at COMMIT, which fails and leaves the transaction to the drop.
  expect.equal(
    exec(
      db,
      "PRAGMA foreign_keys = ON; CREATE TABLE parent (id INTEGER PRIMARY KEY); CREATE TABLE child (p REFERENCES parent (id) DEFERRABLE INITIALLY DEFERRED)",
      Value.Null
    ),
    "ok 0",
  )
  let tx = db.transaction().expect_ok("begin")
  expect.equal(
    tx.execute("INSERT INTO child VALUES (7); INSERT INTO t VALUES ('child')", Value.Null),
    Ok(2)
  )
  match tx.commit() {
    Ok(_) => expect.equal("committed", "an error")
    Err(error) => {
      expect.equal("{error}", "Constraint: FOREIGN KEY constraint failed")
      expect.equal(error.code, 787)
    }
  }
  expect.equal(names(db), ["a", "e"])
  expect.equal(exec(db, "SELECT * FROM child", Value.Null), "ok 0")
  // No transaction is left open, and every statement is finalized.
  expect.equal(exec(db, "BEGIN; COMMIT", Value.Null), "ok 0")
  expect.equal(finalized(db), true)
}

#[test("errors carry SQLite's extended result code and message")]
fn errors_carry_code_and_message() -> Unit {
  let db = Database.memory()
  expect.equal(
    exec(db, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT UNIQUE NOT NULL)", Value.Null),
    "ok 0"
  )
  expect.equal(exec(db, "INSERT INTO t (name) VALUES ('a')", Value.Null), "ok 1")
  match db.execute("INSERT INTO t (name) VALUES ('a')", Value.Null) {
    Ok(_) => expect.equal("inserted", "an error")
    Err(error) => {
      expect.equal(error.kind, SqliteErrorKind.Constraint)
      // SQLITE_CONSTRAINT_UNIQUE.
      expect.equal(error.code, 2067)
      expect.equal(error.message, "UNIQUE constraint failed: t.name")
    }
  }
  match db.execute("SELEC 1", Value.Null) {
    Ok(_) => expect.equal("ran", "an error")
    Err(error) => {
      expect.equal(error.kind, SqliteErrorKind.Sql)
      expect.equal(error.code, 1)
      expect.equal(error.message, "near \"SELEC\": syntax error")
    }
  }
  expect.equal(finalized(db), true)
}

#[test("a file database persists across connections and passes integrity_check")]
fn file_database(context: TestContext) -> Unit {
  let path = context.temp_dir() / "notes.db"
  write_notes(context.fs, path)
  expect.equal(context.fs.exists(path), true)
  let db = Database.open(context.fs, path).expect_ok("reopen")
  let count: Result[List[Value], SqliteError] = db.query("SELECT count(*) AS n, sum(length(body)) AS bytes FROM notes", Value.Null)
  expect.equal("{count.expect_ok("count")}", "[Map({{n: Int(1000), bytes: Int(20890)}})]")
  let check: Result[List[Value], SqliteError] = db.query("PRAGMA integrity_check", Value.Null)
  expect.equal("{check.expect_ok("check")}", "[Map({{integrity_check: String(ok)}})]")
  expect.equal(exec(db, "PRAGMA journal_mode = WAL", Value.Null), "ok 0")
  let mode: Result[List[Value], SqliteError] = db.query("PRAGMA journal_mode", Value.Null)
  expect.equal("{mode.expect_ok("mode")}", "[Map({{journal_mode: String(wal)}})]")

  // A file that is not a database opens (SQLite reads lazily) and fails on
  // first use; a path in a missing directory does not open.
  let junk = context.temp_dir() / "junk.db"
  context.fs.write_text(junk, "not a database ".repeat(100)).expect_ok("write junk")
  let opened = Database.open(context.fs, junk).expect_ok("open junk")
  expect.equal(exec(opened, "SELECT * FROM sqlite_schema", Value.Null), "error Corrupt: file is not a database")
  match Database.open(context.fs, context.temp_dir() / "missing" / "x.db") {
    Ok(missing) => {
      let _ = missing.close()
      expect.equal("opened", "an error")
    }
    Err(error) => expect.equal("{error}", "CantOpen: unable to open database file")
  }
}

fn write_notes(fs: Fs, path: Path) -> Unit {
  let db = Database.open(fs, path).expect_ok("create")
  db.execute("CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL)", Value.Null).expect_ok("create table")
  with tx = db.transaction().expect_ok("begin") {
    for i in 0..1000 {
      tx.execute("INSERT INTO notes (body) VALUES (?)", "note {i}: lorem ipsum").expect_ok("insert")
    }
    tx.commit().expect_ok("commit")
  }
}

#[test("a connection closes exactly when its owner's scope ends, releasing its locks")]
fn connections_close(context: TestContext) -> Unit {
  let path = context.temp_dir() / "locks.db"
  let a = Database.open(context.fs, path).expect_ok("open a")
  expect.equal(exec(a, "CREATE TABLE t (x); BEGIN EXCLUSIVE; INSERT INTO t VALUES (1)", Value.Null), "ok 1")
  let b = Database.open(context.fs, path).expect_ok("open b")
  expect.equal(exec(b, "BEGIN EXCLUSIVE", Value.Null), "error Busy: database is locked")
  // Closing `a` rolls its transaction back and releases the lock.
  a.close().expect_ok("close a")
  expect.equal(exec(b, "BEGIN EXCLUSIVE; INSERT INTO t VALUES (2); COMMIT", Value.Null), "ok 1")
  lock_and_drop(context.fs, path)
  expect.equal(exec(b, "BEGIN EXCLUSIVE; COMMIT", Value.Null), "ok 0")
  let rows: Result[List[Value], SqliteError] = b.query("SELECT x FROM t", Value.Null)
  expect.equal("{rows.expect_ok("rows")}", "[Map({{x: Int(2)}})]")
  expect.equal(finalized(b), true)
}

/// Opens a connection that takes an exclusive lock and returns without
/// committing: the connection closes when the function returns.
fn lock_and_drop(fs: Fs, path: Path) -> Unit {
  let db = Database.open(fs, path).expect_ok("open")
  db.execute("BEGIN EXCLUSIVE; INSERT INTO t VALUES (3)", Value.Null).expect_ok("lock")
}
